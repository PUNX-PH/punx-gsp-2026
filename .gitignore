# Secrets: environment files (web/.gitignore keeps web/.env.example) and Firebase service-account keys, which
# download as <project>-firebase-adminsdk-<id>-<hash>.json
.env
.env.*
!.env.example
*-firebase-adminsdk-*.json
serviceAccount*.json
service-account*.json
# The Blender worker invoker key (blender-worker/README.md says to keep it outside the repository; this is the net) and Python caches
blender-invoker-key*.json
*-invoker-key*.json
__pycache__/
*.pyc
unity/tools/out/

# Scripts written by the live prompt check (web/src/lib/script/tryPrompt.live.test.ts)
/web/.live-scripts/
