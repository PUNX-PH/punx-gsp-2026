<!-- High managed stripping removes code nothing references. Our own assembly is small and its
     settings classes are filled by JsonUtility, so keep all of it. MoonSharp finds its standard-library
     functions by reflection (attributes on module methods), which stripping cannot see, so keep it whole. -->
<linker>
  <assembly fullname="Runner.Runtime" preserve="all"/>
  <assembly fullname="MoonSharp" preserve="all"/>
</linker>
