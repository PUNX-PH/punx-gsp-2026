# Copy to .env.local for local runs and set the same names in Vercel. Real values never go in git or in chat.

# Server only. The service-account key from Firebase (Project settings, Service accounts), as one line of JSON.
FIREBASE_SERVICE_ACCOUNT=
# Server only. The Cloud Storage bucket, e.g. your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
# Server only. Only verified addresses at exactly this domain can sign in. Unset locks everyone out.
ALLOWED_EMAIL_DOMAIN=punx.ai

# Public by design: the Firebase web config (Project settings, General, Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public: the same domain, so the sign-in page can refuse other addresses before sending a link.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=punx.ai

# Describe Game (the AI step). The key is the studio's Anthropic API key (console.anthropic.com), with a monthly spend limit set there.
# Server only. Without it a graph that uses Describe Game fails that step in plain words and nothing else is affected.
ANTHROPIC_API_KEY=
# Optional. The Claude model that answers; the default is claude-sonnet-5-5.
AI_MODEL=
# Optional. New AI answers a person may ask for each UTC day (default 30), and for the whole site (default 300). Answers
# reused from the cache cost nothing and count for nothing. 0 switches a limit to "nobody".
AI_DAILY_LIMIT_PER_PERSON=
AI_DAILY_LIMIT_TOTAL=

# Blender steps (Prepare Model and Make Shape). The worker is a private Cloud Run service (see ../blender-worker/README.md); the
# address is its URL and the key is the key of a service account that may only invoke it, as one line of JSON. Server only.
# Without them a graph that uses these steps fails those steps in plain words and nothing else is affected.
BLENDER_WORKER_URL=
BLENDER_WORKER_KEY=
# Optional. New Blender jobs a person may ask for each UTC day (default 60), and for the whole site (default 600). Results reused
# from the cache cost nothing and count for nothing. 0 switches a limit to "nobody".
BLENDER_DAILY_LIMIT_PER_PERSON=
BLENDER_DAILY_LIMIT_TOTAL=
